\<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot_patrol</name>
  <version>0.1</version>
  <description>A modular ROS 2 software stack for a TurtleBot3 operating in a simulated Gazebo environment. The robot must autonomously patrol a predefined route, detect and avoid obstacles using LiDAR, respond to an emergency-stop service, and publish/log basic telemetry</description>
  <maintainer email="cybervt2007@gmail.com">thewildwt</maintainer>
  <license>:p</license>

  <exec_depend>rclpy</exec_depend>
  
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>turtlebot_patrol_interfaces</exec_depend>

  
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>
  
  <param name="use_sim_time" type="bool" value="true" />

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
